# Copy to .env and adjust. Every setting is optional; the defaults run locally.

# Where files go: fs (a folder or mounted volume) or s3
# PIC2COOKIE_STORAGE__TYPE=fs
# PIC2COOKIE_STORAGE__PATH=data
# PIC2COOKIE_STORAGE__BUCKET=pic2cookie
# PIC2COOKIE_STORAGE__PREFIX=
# PIC2COOKIE_STORAGE__ENDPOINT_URL=http://localhost:9000
# PIC2COOKIE_STORAGE__REGION=
# PIC2COOKIE_STORAGE__ACCESS_KEY_ID=
# PIC2COOKIE_STORAGE__SECRET_ACCESS_KEY=

# Design records in MongoDB instead of design.json files
# PIC2COOKIE_DATABASE__URI=mongodb://localhost:27017
# PIC2COOKIE_DATABASE__NAME=pic2cookie

# Jobs: inline (thread pool in the API) or rq (Redis + `pic2cookie worker`)
# PIC2COOKIE_EXECUTOR=inline
# PIC2COOKIE_REDIS_URL=redis://localhost:6379/0

# Delete Designs not changed for this many days
# PIC2COOKIE_RETENTION__DAYS=30

# Logging to stderr: text or json (one object per line); access = request logs with IPs
# PIC2COOKIE_LOG__LEVEL=INFO
# PIC2COOKIE_LOG__FORMAT=text
# PIC2COOKIE_LOG__ACCESS=true

# Hosting mode (on in docker compose and the Helm chart): a GitHub link and a
# privacy notice (GDPR / DSGVO) that names the operator.
# PIC2COOKIE_HOSTING__ENABLED=false
# PIC2COOKIE_HOSTING__REPOSITORY_URL=https://github.com/LevinTheDoctor/pic2cookie
# PIC2COOKIE_HOSTING__OPERATOR__NAME=
# PIC2COOKIE_HOSTING__OPERATOR__ADDRESS=
# PIC2COOKIE_HOSTING__OPERATOR__EMAIL=
# PIC2COOKIE_HOSTING__PRIVACY_URL=

# PIC2COOKIE_LIMITS__UPLOAD_MB=10
# PIC2COOKIE_LIMITS__MAX_PIXELS=4096
# PIC2COOKIE_LIMITS__JOB_TIMEOUT=120
# PIC2COOKIE_HOST=127.0.0.1
# PIC2COOKIE_PORT=8000
